---
/**
 * The shell every page renders inside: head metadata, the header, and the
 * centred reading column.
 *
 * The design is R4 "Typed" (D-32), which takes Hugo PaperMod's structure: the
 * site name on the left of the header, the menu on the right, a content column
 * narrower than the header above it, and a quiet centred footer. Exact values
 * live in `.claude/rules/website-design.md`, which wins over this file (D-34).
 *
 * Two rulings constrain what happens here. D-07 requires every word to be
 * readable with JavaScript off, so nothing hides pending a script; the one
 * thing a script does add, the theme toggle (D-45), is a control rather than
 * content, and it stays hidden entirely when there is no script to run it. The
 * spec permits Astro view transitions, which degrade to an ordinary navigation
 * where unsupported.
 */

// The single bio source, which supplies the name and the contact links (D-12).
import { profile } from "../data/profile.ts";
// Astro's view transition support, permitted by the motion rules.
import { ClientRouter } from "astro:transitions";
// Tailwind and the design tokens.
import "../styles/global.css";

/** Props accepted by the layout. */
interface Props {
  /** Page title, shown in the browser tab. */
  title: string;
  /** Meta description for search engines and link previews. */
  description: string;
  /** Which nav item to mark as current. Omitted on the home page, which is
   *  reached through the site name rather than through a menu item, and on
   *  nested pages that inherit their section's highlight. */
  current?: "publications" | "talks";
}

// Destructure with a default so a nested page need not pass `current`.
const { title, description, current } = Astro.props;

// The contact address, taken from the one mailto link in the profile rather
// than written out again here, so changing it in one place changes it here too.
const mailto = profile.links.find((link) => link.href.startsWith("mailto:"));

// The navigation, defined once. D-35 ruled the labels: "Talks" rather than a
// generic "Posts", because the section holds talk write-ups. D-39 then removed
// "About", because it pointed at an anchor on the home page rather than a real
// destination, and the site name in the header already goes there. The bio
// lives on the home page and is not advertised separately.
const nav = [
  { key: "talks", label: "Talks", href: "/talks/" },
  { key: "publications", label: "Publications", href: "/publications/" },
  { key: "contact", label: "Contact", href: mailto?.href ?? "#" },
] as const;

// The canonical URL for this page, used for the canonical tag and og:url.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// The year shown in the footer, taken from the build clock rather than hardcoded
// so it cannot go stale silently.
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Manrope from the Google Fonts CDN. D-28 ruled the delivery method and
        D-32 changed which font it delivers. The two preconnects open the
        connections early: fonts.googleapis.com serves the stylesheet and
        fonts.gstatic.com serves the font files, and the second is cross-origin
        so it needs the crossorigin attribute to be reused. `display=swap` means
        text renders in the fallback immediately rather than being invisible
        while the download completes. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Theme init, D-45. Inline and in the head so it runs before the first
        paint: applying a saved choice from a deferred script would show the
        wrong theme for a frame and then swap it, which is worse than not
        offering the choice at all. It also unhides the toggle, so a visitor
        with JavaScript off never sees a control that cannot work. */}
    <script is:inline>
      (() => {
        // Both attributes live on <html>, and a view transition replaces that
        // element's attributes on every navigation. Without re-applying them
        // after each swap, a chosen theme reverts to the system preference on
        // the next page and the toggle itself goes invisible, because the CSS
        // that reveals it keys off data-has-js.
        const apply = () => {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
          document.documentElement.dataset.hasJs = "true";
        };
        apply();
        // Fires after the new document is swapped in but before it paints.
        document.addEventListener("astro:after-swap", apply);

        // Delegated, and bound to the document rather than the button, because
        // view transitions replace the header on every navigation. The document
        // survives, so one listener added here outlives all of them.
        document.addEventListener("click", (event) => {
          if (!event.target.closest("#theme-toggle")) return;
          const root = document.documentElement;
          // The effective theme, which is the explicit choice if one exists and
          // the system preference otherwise.
          const current =
            root.dataset.theme ||
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = current === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          localStorage.setItem("theme", next);
        });
      })();
    </script>

    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-entry focus:px-4 focus:py-2 focus:text-primary"
      >Skip to content</a
    >

    {/* Header. The inner width is --nav-width, deliberately wider than the
        reading column below it, which is inherited from PaperMod. */}
    <header class="bg-theme">
      <nav
        class="mx-auto flex max-w-[calc(1024px+48px)] flex-wrap items-center justify-between px-[24px] py-[10px] leading-[60px]"
        aria-label="Main"
      >
        <a href="/" class="flex items-center gap-[9px] text-[22px] font-bold tracking-[-0.03em]">
          <img
            src="/images/profile_picture.jpg"
            alt=""
            width="34"
            height="34"
            class="size-[34px] rounded-full object-cover"
          />
          {profile.name}
        </a>

        <ul class="flex list-none flex-wrap">
          {
            nav.map((item) => (
              <li class="ms-[24px] first:ms-0">
                <a
                  href={item.href}
                  aria-current={current === item.key ? "page" : undefined}
                  class:list={[
                    "block text-[15.5px] font-medium transition-colors",
                    current === item.key ? "text-primary" : "text-secondary hover:text-primary",
                  ]}
                >
                  <span
                    class:list={[
                      "border-b-2 pb-[2px] transition-colors",
                      current === item.key
                        ? "border-accent"
                        : "border-transparent hover:border-accent",
                    ]}
                  >
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
          {/* The list item centres the toggle against the menu's text, which
              sits on a 60px line box while the icon is only 19px tall. */}
          <li class="ms-[24px] flex items-center">
            {/* Theme toggle (D-45, restyled by D-46). A sun and moon pair
                rather than a word: the glyph is read at a glance where a label
                has to be parsed, and it is the control people already look for
                in this corner. Whichever icon is showing names the theme the
                button switches TO, so the moon offers dark and the sun offers
                light.

                The icons are marked aria-hidden and the button's spoken name
                is built from the sr-only words beside them, because an icon on
                its own tells a screen reader nothing. Those words follow the
                same show-and-hide rule as the icons, so what is announced and
                what is drawn can never disagree.

                Hidden entirely until the head script marks JavaScript as
                present, so a visitor without it never meets a dead control. */}
            <button
              id="theme-toggle"
              type="button"
              class="text-secondary transition-colors hover:text-accent"
            >
              <span class="sr-only">Switch to</span>
              <span class="sr-only to-dark">dark</span>
              <span class="sr-only to-light">light</span>
              <span class="sr-only">theme</span>

              {/* Moon: shown while the light theme is active. */}
              <svg
                class="to-dark"
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>

              {/* Sun: shown while the dark theme is active. The circle is the
                  disc and the eight short strokes are its rays. */}
              <svg
                class="to-light"
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="5"></circle>
                <path
                  d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
                ></path>
              </svg>
            </button>
          </li>
        </ul>
      </nav>
    </header>

    {/* The reading column, narrower than the header above it. */}
    <main id="content" class="mx-auto w-full max-w-[calc(720px+48px)] grow px-[24px] py-[36px]">
      <slot />
    </main>

    <footer
      class="mx-auto mt-[48px] w-full max-w-[calc(720px+48px)] border-t border-border px-[24px] pb-[40px] pt-[20px] text-center text-[12.5px] font-medium leading-[24px] text-secondary"
    >
      <span>&copy; {year} {profile.name}</span>
      <span>&nbsp;·&nbsp;</span>
      <span>Basel, Switzerland</span>
    </footer>
  </body>
</html>
