---
/**
 * The not-found page.
 *
 * GitHub Pages serves the published folder's `404.html` for any path it cannot
 * resolve, and Astro builds `src/pages/404.astro` to exactly that file at the
 * root of the output whatever the URL format, which is what Pages looks for.
 * Without it, a mistyped or stale link falls through to GitHub's own generic
 * page, which carries none of this site's design and offers no route back.
 *
 * D-49 settled what goes on it: an image, a line saying the page is not there,
 * and one link home. Nothing else. The earlier version listed all three routes;
 * that list is gone, because a single obvious way out is easier to act on than
 * a menu, and the header already carries the full navigation anyway.
 */

// The shell, which supplies the header, the reading column and the footer.
import Base from "../layouts/Base.astro";
// For the page title.
import { profile } from "../data/profile.ts";
---

<Base
  title={`Page not found · ${profile.name}`}
  description="That page does not exist. A link back to the home page."
>
  {/* Centred in the space the header and footer leave, so the block sits in the
      middle of the screen rather than hard under the header. */}
  <section class="flex min-h-[62vh] flex-col items-center justify-center text-center">
    {/* The circular mask is the same treatment as the profile photograph, so
        the two pages feel related. The alt text is deliberately empty: the
        image says nothing the heading below does not already say, so a screen
        reader should skip it rather than stop to describe decoration. */}
    <img
      src="/images/404-molecule.webp"
      alt=""
      width="200"
      height="200"
      class="mb-[28px] size-[200px] rounded-full object-cover"
    />

    <h1 class="m-0 text-[30px] font-extrabold leading-[1.2] tracking-[-0.035em]">Page not found</h1>

    <p class="m-0 mt-[10px] max-w-[42ch] text-[16px] leading-[1.6] text-secondary">
      That address does not point at anything. It may have moved, or the link may have been
      mistyped.
    </p>

    {/* One way out, styled as the site's pill button so it reads as the action
        rather than as another piece of text. */}
    <a
      href="/"
      class="mt-[28px] rounded-full bg-tertiary px-[16px] py-[7px] text-[14.5px] font-medium transition-colors hover:bg-accent hover:text-on-accent active:scale-[0.96]"
      >Back to the home page</a
    >
  </section>
</Base>
