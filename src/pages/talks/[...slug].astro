---
/**
 * A single talk write-up.
 *
 * D-19 ruled these are articles rather than slide dumps, so the body of each
 * markdown file is real prose and this template's job is to set it well: a
 * comfortable measure, clear heading hierarchy, and nothing between the reader
 * and the text.
 *
 * The route is a rest parameter so a talk can later be nested, for example
 * /talks/2026/summer-school/, without changing this file.
 */

// The shell.
import Base from "../../layouts/Base.astro";
// `render` turns a collection entry's markdown body into a component.
import { getCollection, render } from "astro:content";
// The type of the generated static paths, so the signature is checked.
import type { GetStaticPaths } from "astro";

/**
 * Tells Astro which talk pages to build.
 *
 * Drafts are excluded here rather than hidden at render time, so an unfinished
 * write-up produces no page at all and cannot be found by guessing its URL.
 *
 * @returns One route per published talk, with the entry passed through as a prop.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  // Every talk in the collection, drafts included at this point.
  const talks = await getCollection("talks");
  // Keep only the published ones, and hand each entry to the page as a prop.
  return talks
    .filter((talk) => !talk.data.draft)
    .map((talk) => ({ params: { slug: talk.id }, props: { talk } }));
};

// The entry for this route, supplied by getStaticPaths above.
const { talk } = Astro.props;
// Render the markdown body into a component the template can place.
const { Content } = await render(talk);

/**
 * Formats the delivery date in full.
 *
 * @param date - The date the talk was given.
 * @returns For example "14 August 2026".
 * @example
 * ```ts
 * formatDate(new Date("2026-08-14")); // "14 August 2026"
 * ```
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
}
---

<Base title={`${talk.data.title} · Talks`} description={talk.data.description} current="talks">
  <article>
    <header class="mb-[36px]">
      {/* Breadcrumb back to the index, and the delivery date. */}
      <p class="m-0 text-[14px] font-medium text-secondary">
        <a href="/talks/" class="transition-colors hover:text-accent">Talks</a>
        <span>&nbsp;·&nbsp;</span>
        <time datetime={talk.data.date.toISOString().slice(0, 10)}>
          {formatDate(talk.data.date)}
        </time>
        <span>&nbsp;·&nbsp;{talk.data.venue}</span>
      </p>

      <h1 class="m-0 mt-[10px] text-[30px] font-extrabold leading-[1.2] tracking-[-0.035em]">
        {talk.data.title}
      </h1>
    </header>

    <div class="talk-body">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* Typography for rendered markdown. Written here rather than with utilities
   * because the elements come from markdown and carry no classes to hang them
   * on, and because D-20 keeps styling reasoning out of exempt markup where it
   * can be commented properly. */
  .talk-body :global(p) {
    margin-block: 0 1.15em;
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--color-content);
  }

  .talk-body :global(h2) {
    margin-block: 2rem 0.75rem;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-primary);
  }

  .talk-body :global(h3) {
    margin-block: 1.6rem 0.5rem;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-primary);
  }

  .talk-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 30%, transparent);
    text-underline-offset: 3px;
  }

  .talk-body :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  /* Lists. Tailwind's reset strips the marker and the indent from every list on
   * the site, which is right for the navigation and the entry lists and wrong
   * here: a run of markdown bullets was rendering as unmarked lines that ran
   * straight into the paragraph after them. Restored for prose only. */
  .talk-body :global(ul:not([class])),
  .talk-body :global(ol:not([class])) {
    margin-block: 0 1.15em;
    padding-inline-start: 1.35em;
    font-size: 16.5px;
    line-height: 1.78;
    color: var(--color-content);
  }

  .talk-body :global(ul:not([class])) {
    list-style: disc;
  }

  .talk-body :global(ol:not([class])) {
    list-style: decimal;
  }

  .talk-body :global(li:not([class])) {
    margin-block: 0.3em;
    padding-inline-start: 0.25em;
  }

  /* The bullet itself, quieter than the words beside it. */
  .talk-body :global(li:not([class]))::marker {
    color: var(--color-secondary);
  }

  /* A figure placed by a component brings its own frame, so this rule is only
   * for a bare markdown image. It is scoped to images that are not inside one
   * of the figure components, which would otherwise get a second border. */
  .talk-body :global(p > img) {
    margin-block: 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  /* A pulled-out line, which in the deck was the one sentence left on the wall
   * under a picture. Set larger than the prose rather than smaller, because it
   * is the point being made rather than an aside. */
  .talk-body :global(blockquote) {
    margin-block: 1.75rem;
    border-left: 2px solid var(--color-accent);
    padding-left: 1.1rem;
  }

  .talk-body :global(blockquote p) {
    margin-block: 0;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--color-primary);
  }

  /* Code needs a monospace to be readable, and the design carries no monospace
   * webfont. The system stack is used rather than adding a second font request,
   * so this costs nothing and stays out of the way of the type scale. */
  .talk-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.86em;
  }

  .talk-body :global(pre) {
    margin-block: 1.5rem;
    padding: 1rem;
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-entry);
  }
</style>
