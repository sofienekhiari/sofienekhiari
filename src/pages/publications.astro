---
/**
 * The publications page.
 *
 * A content collection since D-25, so adding a paper means dropping a markdown
 * file into src/content/publications rather than editing TypeScript.
 *
 * The layout is "Index" (D-47): a two column record rather than a feed. The
 * date and the venue sit in a left rail and the title block sits beside them,
 * which is the same shape the experience list on the home page already uses, so
 * the site now has one consistent way of presenting a chronology. Hierarchy is
 * carried by weight and colour rather than by size, which is what the previous
 * version lacked: the meta line, the authors and the tags were all the same
 * grey at nearly the same weight, so nothing anchored the eye.
 *
 * Each entry is a single block-level link wrapping the whole row, which the
 * design specification requires so that the entry is one click target and one
 * tab stop. That is why the DOI appears as text rather than as its own link: a
 * link inside a link is invalid HTML and would break keyboard navigation.
 *
 * Where the row points is decided by `linkFor` below (D-48): straight at the
 * arXiv PDF where the paper is on arXiv, and through the DOI resolver for
 * anything else.
 */

// The shell.
import Base from "../layouts/Base.astro";
// Reads the collection at build time.
import { getCollection } from "astro:content";
// For the page title, the description, and to recognise his name in an author
// list without hardcoding it in two places.
import { profile } from "../data/profile.ts";

// Newest first, which is how a reader scans a publication list.
const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/**
 * Formats a publication date as a month and year.
 *
 * @param date - The publication date from frontmatter.
 * @returns For example "September 2025".
 * @example
 * ```ts
 * formatDate(new Date("2025-09-01")); // "September 2025"
 * ```
 */
function formatDate(date: Date): string {
  // en-GB gives "September 2025" rather than the American month-first order.
  return date.toLocaleDateString("en-GB", { year: "numeric", month: "long", timeZone: "UTC" });
}

/**
 * Works out where a publication row should point.
 *
 * Every entry stores a DOI, and a DOI always resolves somewhere sensible, so
 * that is the safe fallback. But arXiv mints its DOIs to a fixed pattern,
 * `10.48550/arXiv.<identifier>`, which means the identifier can be read
 * straight out of the DOI and turned into a link to the PDF itself. For an
 * arXiv paper that saves the reader a stop at the abstract page.
 *
 * Nothing is hardcoded per paper: a new arXiv entry gets a PDF link for free,
 * and a journal paper, whose PDF lives behind a publisher URL nobody can guess
 * from a DOI, keeps the resolver.
 *
 * @param doi - The bare DOI from frontmatter, with no resolver prefix.
 * @returns An absolute URL to open when the row is clicked.
 * @example
 * ```ts
 * linkFor("10.48550/arXiv.2509.12915"); // "https://arxiv.org/pdf/2509.12915"
 * linkFor("10.1021/acs.jcim.4c00001");  // "https://doi.org/10.1021/acs.jcim.4c00001"
 * ```
 */
function linkFor(doi: string): string {
  // Capture whatever follows the arXiv prefix; that remainder is the arXiv
  // identifier. Case-insensitive because the "arXiv" in a DOI is sometimes
  // written in lower case.
  const arxiv = doi.match(/^10\.48550\/arXiv\.(.+)$/i);
  // No prefix match means this is not an arXiv paper, so send the reader
  // through the DOI resolver, the one link that is guaranteed to work.
  if (!arxiv) return `https://doi.org/${doi}`;
  // arxiv.org/pdf/<identifier> serves the newest version of the PDF. Asking for
  // no particular version is deliberate: pinning v1 would freeze the link on a
  // superseded draft the moment the paper is revised.
  return `https://arxiv.org/pdf/${arxiv[1]}`;
}
---

<Base
  title={`Publications · ${profile.name}`}
  description="Preprints and papers in computational pharmacy, molecular docking and drug discovery."
  current="publications"
>
  <h1 class="m-0 text-[26px] font-bold leading-[1.2] tracking-[-0.03em]">Publications</h1>
  <p class="mb-[30px] mt-[8px] text-[15px] leading-[1.55] text-secondary">
    Preprints and papers in computational pharmacy, molecular docking and drug discovery.
  </p>

  {/* The column headings. They are what makes the two columns read as a record
      rather than as an accident of alignment, and the heavier rule under them
      separates the headings from the rows in a way a hairline would not. */}
  <div
    class="row headings border-b-2 border-primary pb-[8px] text-[11px] font-extrabold uppercase tracking-[0.12em] text-secondary"
  >
    <span>Date</span>
    <span>Work</span>
  </div>

  {
    publications.map((pub) => (
      <a href={linkFor(pub.data.doi)} class="row entry border-b border-border py-[20px]">
        {/* Left rail: when it appeared, and where. */}
        <div>
          <div class="text-[14px] font-semibold leading-[1.45]">
            <time datetime={pub.data.date.toISOString().slice(0, 7)}>
              {formatDate(pub.data.date)}
            </time>
          </div>
          <div class="mt-[3px] text-[13px] font-medium text-secondary">
            {/* Preprint status is the one thing on this page an academic reader
                checks first, so it is the only coloured word in the rail. */}
            {pub.data.preprint && <span class="font-bold text-accent">Preprint&nbsp;·&nbsp;</span>}
            {pub.data.venue}
          </div>
        </div>

        {/* Right column: the paper itself. */}
        <div>
          <h2 class="title m-0 text-[19px] font-bold leading-[1.4] tracking-[-0.02em] transition-colors">
            {pub.data.title}
          </h2>

          <p class="mt-[7px] text-[14.5px] leading-[1.5] text-secondary">
            {pub.data.authors.map((author, index) => (
              <>
                {index > 0 && ", "}
                {/* His own name is the only one set in the page's main colour,
                    so a reader scanning a list of co-authored papers can see at
                    a glance which ones are his and where he sits in the order.
                    Compared against the profile rather than written out again,
                    so the two cannot drift apart. */}
                {author === profile.name ? (
                  <span class="font-semibold text-primary">{author}</span>
                ) : (
                  author
                )}
              </>
            ))}
          </p>

          <p class="mt-[7px] text-[12.5px] font-medium tracking-[0.01em] text-secondary">
            {pub.data.doi}
          </p>
        </div>
      </a>
    ))
  }

  <!-- A closing line belongs here, pointing at wherever the authoritative record
       lives (ORCID, Google Scholar, an institutional page). It is deliberately
       empty until Sofiene says which, because an earlier draft claimed GitHub
       held a complete publication record, which is not something I can support. -->
</Base>

<style>
  /* The two column shape, shared by the headings and every row so their edges
     line up. Written here rather than as utilities because the collapse below
     needs a media query, and this matches how the experience list on the home
     page does the same job. */
  .row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: var(--gap);
    /* The table bleeds 12px past the reading column on both sides and pulls the
       same distance back with a negative margin, so the text still lines up
       with the heading above while the hover band gets breathing room. Without
       it the highlight would start exactly at the first letter, which reads as
       a rendering fault rather than as a hover state.
       It is on .row rather than on .entry alone so that the rule under the
       column headings and the rules under the rows share one set of edges. */
    margin-inline: -12px;
    padding-inline: 12px;
  }

  .entry {
    transition: background-color 0.15s ease;
  }

  .entry:hover {
    background-color: var(--color-tertiary);
  }

  /* The title follows the hover of the whole row, not of itself, because the
     row is the link. */
  .entry:hover .title {
    color: var(--color-accent);
  }

  /* On a narrow screen 150px of rail is most of the width, so the two columns
     stack and the rail sits above the title instead of beside it. */
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    /* Once the columns stack there are no columns left to label, and the two
       words would sit one above the other saying nothing. The labels go but the
       row stays, collapsed to nothing, so its heavy rule still opens the list
       the way it does on a wide screen. */
    .headings span {
      display: none;
    }

    .headings {
      padding-bottom: 0;
    }
  }
</style>
