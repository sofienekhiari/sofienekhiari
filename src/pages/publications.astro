---
/**
 * The publications page.
 *
 * A collection since D-25, so adding a paper means dropping a markdown file
 * into src/content/publications rather than editing TypeScript.
 *
 * The list is short today. Rather than padding it out, the page states the
 * position plainly and links to the places where the full record lives, which
 * is both honest and more useful to an academic reader than a thin list
 * pretending to be a long one.
 */

// The shell.
import Base from "../layouts/Base.astro";
// Reads the collection at build time.
import { getCollection } from "astro:content";
// For the page description.
import { profile } from "../data/profile.ts";

// Newest first, which is how a reader scans a publication list.
const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/**
 * Formats a publication date as a month and year.
 *
 * @param date - The publication date from frontmatter.
 * @returns For example "September 2025".
 */
function formatDate(date: Date): string {
  // en-GB gives "September 2025" rather than the American month-first order.
  return date.toLocaleDateString("en-GB", { year: "numeric", month: "long", timeZone: "UTC" });
}
---

<Base
  title={`Publications · ${profile.name}`}
  description="Peer-reviewed publications and preprints in computational pharmacy, molecular docking and drug discovery."
  current="publications"
>
  <h1 class="text-lg font-semibold tracking-tight">Publications</h1>
  <p class="mt-2 text-sm text-muted">
    Preprints and papers in computational pharmacy, molecular docking and drug discovery.
  </p>

  <ol class="mt-8 list-none space-y-8" role="list">
    {
      publications.map((pub) => (
        <li class="border-t border-line pt-5">
          <h2 class="text-base font-medium leading-snug tracking-tight">
            <a
              href={`https://doi.org/${pub.data.doi}`}
              class="transition-colors hover:text-accent"
            >
              {pub.data.title}
            </a>
          </h2>

          <p class="mt-1.5 text-sm text-faint">{pub.data.authors.join(", ")}</p>

          <p class="mt-1 text-sm text-muted">
            <em class="not-italic">{pub.data.venue}</em>
            {pub.data.preprint && <span class="text-faint"> · preprint</span>}
            <span class="text-faint">
              {" · "}
              <time datetime={pub.data.date.toISOString().slice(0, 7)}>
                {formatDate(pub.data.date)}
              </time>
            </span>
          </p>

          {pub.data.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5 list-none">
              {pub.data.tags.map((tag) => (
                <li class="rounded-full bg-accent/8 px-2.5 py-0.5 text-xs text-accent">{tag}</li>
              ))}
            </ul>
          )}

          <p class="mt-3 font-mono text-xs">
            <a
              href={`https://doi.org/${pub.data.doi}`}
              class="text-accent underline decoration-accent/30 underline-offset-4 transition-colors hover:decoration-accent"
            >
              doi.org/{pub.data.doi}
            </a>
          </p>
        </li>
      ))
    }
  </ol>

<!-- A closing line belongs here, pointing at wherever the authoritative record
     lives (ORCID, Google Scholar, an institutional page). It is deliberately
     empty until Sofiene says which, because the previous draft claimed GitHub
     held a complete publication record, which is not something I can support. -->
</Base>
